{
  "name": "groq-intelligent-code-reviewer",
  "displayName": "Groq Intelligent Code Reviewer",
  "description": "An AI-powered VS Code extension that detects system-level bugs using the Groq API (openai/gpt-oss-120b).",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:groq-reviewer.analyzeCode",
    "onCommand:groq-reviewer.detectBugs",
    "onCommand:groq-reviewer.checkModelAccess",
    "onView:groq-reviewer.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "groq-reviewer.analyzeCode",
        "title": "Groq: Analyze Code"
      },
      {
        "command": "groq-reviewer.detectBugs",
        "title": "Groq: Detect Bugs in Workspace"
      },
      {
        "command": "groq-reviewer.checkModelAccess",
        "title": "Groq: Check Model Access (Diagnostic)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groqReviewerFinal",
          "title": "Groq Reviewer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "groqReviewerFinal": [
        {
          "id": "groq-reviewer.sidebar",
          "name": "Intelligent Reviewer",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "groq-reviewer.analyzeCode",
          "when": "view == groq-reviewer.sidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Groq Intelligent Code Reviewer",
      "properties": {
        "groq-reviewer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your Groq API Key."
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "groq-sdk": "^1.5.0",
    "path-browserify": "^1.0.1"
  }
}
